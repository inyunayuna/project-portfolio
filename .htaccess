# =============================================================================
# Hostinger / Apache 설정
# =============================================================================
# 사이트 루트에 그대로 업로드하면 동작합니다.
# 도메인이 HTTPS만 쓰도록 강제하고, 기본 캐싱·압축을 켭니다.
# =============================================================================

# --- 디렉토리 목록 차단 -------------------------------------------------------
Options -Indexes

# --- HTTPS 강제 (Hostinger에서 SSL 발급되어 있어야 함) ----------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 깔끔한 URL: /project?id=xxx → /project/xxx 같은 처리 원하면 여기 확장
  # 지금은 .html 명시 방식 사용
</IfModule>

# --- 404 페이지 ---------------------------------------------------------------
ErrorDocument 404 /404.html

# --- MIME 타입 (ES Modules + 폰트 + JSON) ------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# --- 압축 (텍스트 자산 모두 gzip) --------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 캐싱 ---------------------------------------------------------------------
# 파일명에 해시가 없는 HTML/JS/CSS/JSON은 재검증하고, 미디어는 길게 캐싱합니다.
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: 항상 새로 받기
  ExpiresByType text/html "access plus 0 seconds"

  # 데이터: 수정된 JSON을 즉시 재검증
  ExpiresByType application/json "access plus 0 seconds"

  # 코드: 변경 시 즉시 반영 (아래 Cache-Control로 재검증)
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- 보안 헤더 ----------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions-Policy: 필요한 권한만 (포트폴리오라 거의 다 끔)
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- 숨김 파일 접근 차단 -----------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
